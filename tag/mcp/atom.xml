&lt;td&gt;&lt;code&gt;/plan&lt;/code&gt; &lt;code&gt;/auto&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;规划模式 &amp;#x2F; 自动模式&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/goal&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;设定目标并看护长任务（自动 check-in）&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/checkpoints&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;检查点管理、回滚&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/compact&lt;/code&gt; &lt;code&gt;/recap&lt;/code&gt; &lt;code&gt;/insights&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;上下文压缩 &amp;#x2F; 回顾 &amp;#x2F; 洞察&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/config&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;打开设置（输出风格、键位等）&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/agents&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;子代理管理&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/mcp&lt;/code&gt;&lt;/td&gt;
&lt;td&gt;MCP 服务器管理（list&amp;#x2F;get&amp;#x2F;add）&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;&lt;code&gt;/plugin&lt;/code&gt;&lt;/td&gt;
